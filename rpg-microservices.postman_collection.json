						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Warrior\",\n  \"descripcion\": \"An unstoppable melee fighter clad in heavy plate armor\",\n  \"rolPrincipal\": \"Tank\",\n  \"dadoDeVida\": 12\n}"
