						"method": "GET",
						"url": "{{baseUrlClases}}/api/clases/999"
					}
				},
				{
					"name": "Create Clase",
					"request": {
						"method": "POST",
						"url": "{{baseUrlClases}}/api/clases",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
