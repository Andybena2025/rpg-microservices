{
	"info": {
		"name": "RPG Microservices",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"description": "Full CRUD + error cases for clases-service and personajes-service"
	},
	"variable": [
		{
			"key": "baseUrlClases",
			"value": "http://18.214.99.108:8081",
			"description": "AWS EC2 deployment (for localhost use: http://localhost:8081)"
		},
		{
			"key": "baseUrlPersonajes",
			"value": "http://18.214.99.108:8082",
			"description": "AWS EC2 deployment (for localhost use: http://localhost:8082)"
		}
	],
