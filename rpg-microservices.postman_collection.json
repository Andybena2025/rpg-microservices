							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombre\": \"Ghost\",\n  \"descripcion\": \"Does not exist\",\n  \"rolPrincipal\": \"None\",\n  \"dadoDeVida\": 1\n}"
						}
					}
				},
				{
					"name": "Delete Clase",
					"request": {
						"method": "DELETE",
						"url": "{{baseUrlClases}}/api/clases/6"
